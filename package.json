{
  "name": "herdr-chat",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Native GUI chat for Pi, Claude Code and Codex in the Herdr desktop app",
  "license": "MIT",
  "author": "Adam Chmara",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ChmaraX/herdr-chat.git"
  },
  "homepage": "https://github.com/ChmaraX/herdr-chat#readme",
  "bugs": {
    "url": "https://github.com/ChmaraX/herdr-chat/issues"
  },
  "engines": {
    "node": ">=24"
  },
  "herdr": {
    "tested": {
      "app": "0.1.13",
      "core": "0.1.18"
    },
    "minimum": {
      "app": "0.1.12",
      "why": "it needs mods that take the keyboard, for the composer, and agents that run in herdr-core: both new in 0.1.12"
    }
  },
  "bin": {
    "pi-chat-host": "bin/pi-chat-host",
    "pi-chat-subagent": "bin/pi-chat-subagent"
  },
  "files": [
    "bin/",
    "host/",
    "install/",
    "install.sh",
    "mod/",
    "extension/",
    "LICENSE",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "test": "node --test --test-concurrency=4 'tests/host/*.test.ts'",
    "test:built": "PI_CHAT_TEST_HOST=\"dist/herdr-chat-$npm_package_version/host/main.js\" npm test",
    "test:install": "tests/release/install-e2e.sh",
    "typecheck": "tsc --noEmit -p .",
    "build": "node scripts/build.mjs",
    "release": "npm run typecheck && npm test && npm run build && npm run test:built",
    "e2e": "tests/e2e/run.sh"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "esbuild": "^0.28.2",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "beautiful-mermaid": "^1.1.3",
    "highlight.js": "^11.12.0"
  }
}
